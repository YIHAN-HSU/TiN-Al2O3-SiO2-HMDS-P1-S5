# Public service only. Local launch.mjs remains on 3200/3201.
PORT=10000
S5_PUBLIC_MODE=1
PUBLIC_DIST_DIR=dist
PUBLIC_MAX_CONCURRENCY=1
PYTHON_EXECUTABLE=python3
PYTHONDONTWRITEBYTECODE=1
OMP_NUM_THREADS=1
# No API keys, shared history database, or guest-data volume.

# Required for public-server in every environment; leave values out of source control.
# Use npm run auth:hash and npm run auth:secret in your own Windows terminal.
ADSORVIA_PASSWORD_HASH=
ADSORVIA_SESSION_SECRET=
